                        color: '#333',
                        fontSize: 10,    // 增加字体大小
                        lineHeight: 14   // 增加行高
                    },
                    data: ['地理问题', '地理场景', '对象系统', '系统机理', '时空数据', '数据来源', '处理方法', '集成模型', '基础模型', '开发步骤', '评价方法', '评价结果', '模型应用', '应用结果', '总结讨论', '地理概念']
        },
                animationDurationUpdate: 1500,
                animationEasingUpdate: 'quinticInOut',
                series: [
                    {
            type: 'graph',
            layout: 'force',
                        symbolSize: 45,
                        edgeSymbol: ['circle', 'arrow'],
                        edgeSymbolSize: [4, 8],
                        data: kgData.nodes,
                        links: kgData.links,
                        categories: [
                            {name: '地理问题'},
                            {name: '地理场景'},
                            {name: '对象系统'},
                            {name: '系统机理'},
                            {name: '时空数据'},
                            {name: '数据来源'},
                            {name: '处理方法'},
                            {name: '集成模型'},
                            {name: '基础模型'},
                            {name: '开发步骤'},
                            {name: '评价方法'},
                            {name: '评价结果'},
                            {name: '模型应用'},
                            {name: '应用结果'},
                            {name: '总结讨论'},
                            {name: '地理概念'}
                        ],
            roam: true,
            label: {
                            normal: {
                            show: true,
                            position: 'right',
                                textStyle: {
                                    color: '#333',
                                    fontSize: 11,
                                    fontWeight: 600,
                                    backgroundColor: 'rgba(255, 255, 255, 0.85)',
                                    padding: [4, 6],
                                    borderRadius: 3,
                                    shadowColor: 'rgba(0, 0, 0, 0.2)',
                                    shadowBlur: 2
                                }
                            }
                        },
                        edgeLabel: {
                            normal: {
                                show: true,
                                formatter: function(x) {
                                    return x.data.name;
                                },
                                textStyle: {
                                    fontSize: 10,
                                    color: '#666'
                                }
                            }
            },
            force: {
                            repulsion: 800,
                            gravity: 0.1,
                            edgeLength: 100,
                            layoutAnimation: true
                        },
                        draggable: true,
                        itemStyle: {
                            normal: {
                                borderColor: '#fff',
                                borderWidth: 1,
                                shadowBlur: 10,
                                shadowColor: 'rgba(0, 0, 0, 0.3)'
                            }
                        },
                        lineStyle: {
                            normal: {
                                opacity: 0.7,
                                width: 1,
                                curveness: 0.1,
                                color: '#aaa'
                            }
                        },
                        emphasis: {
                            focus: 'adjacency',
                            lineStyle: {
                                width: 5,
                                color: '#409EFF',
                                opacity: 0.9
                            },
                            itemStyle: {
                                shadowBlur: 20,
                                shadowColor: 'rgba(0, 0, 0, 0.5)',
                                borderColor: '#409EFF',
                                borderWidth: 2
                            },
                            label: {
                                show: true,
                                fontSize: 14,
                                fontWeight: 'bold',
                                backgroundColor: 'rgba(255, 255, 255, 0.9)',
                                padding: [4, 8],
                                borderRadius: 4
                            }
                        }
                    }
                ]
            };
            
            // 设置图表选项
            chart.setOption(option);
            
            // 应用新的事件处理
            WendaApp.utils.setupChartEventHandlers(chart);
            
            // 启用鼠标事件处理
            state.preventMouseEvents = false;
            
            return chart;
        } catch (err) {
            console.error(`[Frontend] 初始化知识图谱失败:`, err);
            return null;
        }
    }
    
    // 初始化流程图
    function initProcessFlowchart(containerId = 'processFlowchart') {
        try {
            console.log(`[Frontend] 开始初始化流程图: #${containerId}`);
            
            // 检查容器是否存在
        const container = document.getElementById(containerId);
    if (!container) {
                console.error(`[Frontend] 流程图容器 #${containerId} 不存在`);
                return;
            }
            
            // 检查echarts是否可用
            if (typeof echarts === 'undefined') {
                console.error('[Frontend] ECharts库未加载，无法初始化流程图');
                return;
            }
            
            // 初始化图表并存储引用
            if (!WendaApp.charts) {
                WendaApp.charts = {};
            }
            
            // 如果已经存在图表实例，先销毁
            if (WendaApp.charts[containerId] && !WendaApp.charts[containerId].isDisposed()) {
                console.log(`[Frontend] 销毁现有流程图实例: #${containerId}`);
                WendaApp.charts[containerId].dispose();
            }
            
            // 增加容器可见性检查
            if (container.offsetParent === null) {
                console.warn(`[Frontend] 流程图容器 #${containerId} 不可见，可能影响渲染`);
            }
            
            // 确保容器尺寸合适
            if (container.offsetWidth < 50 || container.offsetHeight < 50) {
                console.warn(`[Frontend] 流程图容器尺寸过小: ${container.offsetWidth}x${container.offsetHeight}`);
                container.style.height = '400px'; // 设置最小高度
            }
            
            // 创建新的图表实例
            console.log(`[Frontend] 创建新的流程图实例: #${containerId}`);
            WendaApp.charts[containerId] = echarts.init(container);
            
            // 流程图配置
        const option = {
                title: {
                    text: '地理建模分析流程',
                    subtext: '累进式问题分解与处理流程',
                    left: 'center'
            },
                tooltip: {
                    trigger: 'item',
                    formatter: function(params) {
                        if (params.dataType === 'node') {
                            return `${params.data.name}<br/>${params.data.value || ''}`;
                        }
                        return '';
                    }
            },
                animationDurationUpdate: 500,
            animationEasingUpdate: 'quinticInOut',
                series: [{
                type: 'graph',
                layout: 'none',
                        symbolSize: 50,
                roam: true,
                label: {
                        show: true,
                        position: 'inside',
                        fontSize: 12,
                        color: '#333',
                        fontWeight: 'bold'
                },
                edgeSymbol: ['circle', 'arrow'],
                edgeSymbolSize: [4, 10],
                edgeLabel: {
                        show: false
                    },
                    data: [
                        {
                            name: '问题输入',
                            value: '用户输入地理相关问题',
                            x: 300,
                            y: 50,
                            fixed: true,
                            itemStyle: { color: '#91cc75' }
                        },
                        {
                            name: '问题分解',
                            value: '将复杂问题分解为子问题',
                            x: 300,
                            y: 150,
                            fixed: true,
                            itemStyle: { color: '#fac858' }
                        },
                        // 问题1相关节点
                        {
                            name: '地理位置识别',
                            value: '识别地理实体和位置信息',
                            x: 100,
                            y: 250,
                            itemStyle: { color: '#ee6666' }
                        },
                        {
                            name: '实体识别1',
                            value: '提取地理位置关键词',
                            x: 100,
                            y: 350,
                            itemStyle: { color: '#73c0de' }
                        },
                        {
                            name: '图谱查询1',
                            value: '查询地理位置基本信息',
                            x: 100,
                            y: 450,
                            itemStyle: { color: '#3ba272' }
                        },
                        // 问题2相关节点
                        {
                            name: '地理特征分析',
                            value: '分析地理特征和属性',
                            x: 300,
                            y: 250,
                            itemStyle: { color: '#ee6666' }
                        },
                        {
                            name: '实体识别2',
                            value: '识别地理特征属性',
                            x: 300,
                            y: 350,
                            itemStyle: { color: '#73c0de' }
                        },
                        {
                            name: '图谱查询2',
                            value: '查询地理特征详细信息',
                            x: 300,
                            y: 450,
                            itemStyle: { color: '#3ba272' }
                        },
                        // 问题3相关节点
                        {
                            name: '地理关系推理',
                            value: '分析地理实体间关系',
                            x: 500,
                            y: 250,
                            itemStyle: { color: '#ee6666' }
                        },
                        {
                            name: '实体识别3',
                            value: '识别地理关系实体',
                            x: 500,
                            y: 350,
                            itemStyle: { color: '#73c0de' }
                        },
                        {
                            name: '图谱查询3',
                            value: '查询地理关系信息',
                            x: 500,
                            y: 450,
                            itemStyle: { color: '#3ba272' }
                        },
                        // 结果生成节点
                        {
                            name: '结果生成',
                            value: '整合所有分析结果',
                            x: 300,
                            y: 550,
                            fixed: true,
                            symbolSize: 60,
                            itemStyle: { color: '#fc8452' }
                        }
                    ],
                    links: [
                        // 主流程连接
                        { source: '问题输入', target: '问题分解', lineStyle: { width: 3 } },
                        
                        // 问题分解到第一个问题组
                        { source: '问题分解', target: '地理位置识别' },
                        { source: '地理位置识别', target: '实体识别1' },
                        { source: '实体识别1', target: '图谱查询1' },
                        
                        // 第一个问题组到第二个问题组
                        { source: '地理位置识别', target: '地理特征分析' },
                        { source: '实体识别1', target: '地理特征分析' },
                        { source: '图谱查询1', target: '地理特征分析' },
                        { source: '地理特征分析', target: '实体识别2' },
                        { source: '实体识别2', target: '图谱查询2' },
                        
                        // 第二个问题组到第三个问题组
                        { source: '地理特征分析', target: '地理关系推理' },
                        { source: '实体识别2', target: '地理关系推理' },
                        { source: '图谱查询2', target: '地理关系推理' },
                        { source: '地理关系推理', target: '实体识别3' },
                        { source: '实体识别3', target: '图谱查询3' },
                        
                        // 所有问题组到结果生成
                        { source: '图谱查询1', target: '结果生成' },
                        { source: '图谱查询2', target: '结果生成' },
                        { source: '图谱查询3', target: '结果生成' }
                        ],
                        lineStyle: {
                        color: '#666',
                        width: 1,
                        curveness: 0.1
                    },
                    emphasis: {
                        focus: 'adjacency',
                        lineStyle: {
                            width: 4
                        },
                        itemStyle: {
                            shadowBlur: 10,
                            shadowColor: 'rgba(0,0,0,0.5)'
                        }
                    }
                }]
            };
            
            // 设置图表配置
            WendaApp.charts[containerId].setOption(option);
            
            // 添加事件处理
            WendaApp.utils.setupChartEventHandlers(WendaApp.charts[containerId]);
            
            // 设置resize监听
            window.addEventListener('resize', function() {
                if (WendaApp.charts[containerId] && !WendaApp.charts[containerId].isDisposed()) {
                    WendaApp.charts[containerId].resize();
                }
            });
            
            console.log(`[Frontend] 流程图初始化成功: #${containerId}`);
            
            // 取消鼠标事件阻止，确保交互正常
            state.preventMouseEvents = false;
            
            return WendaApp.charts[containerId];
        } catch (error) {
            console.error(`[Frontend] 初始化流程图失败:`, error);
            // 添加错误信息显示
            const container = document.getElementById(containerId);
            if (container) {
                container.innerHTML = `
                    <div class="alert alert-danger" role="alert">
                        <h6>流程图加载失败</h6>
                        <small>${error.message}</small>
                        <button class="btn btn-sm btn-outline-danger mt-2" onclick="WendaApp.initProcessFlowchart('${containerId}')">
                            <i class="fas fa-sync-alt"></i> 重试
                        </button>
                    </div>
                `;
            }
        }
    }
    
    // 初始化历史知识图谱
    function initHistoryKg(containerId, kgData) {
        console.log(`[Frontend] 初始化历史知识图谱 #${containerId}`);
    const container = document.getElementById(containerId);
    if (!container) {
            console.error(`[Frontend] 未找到历史知识图谱容器 #${containerId}`);
            return null;
        }
        
        try {
            // 验证KG数据
            if (!kgData || !kgData.nodes || !kgData.links) {
                console.error(`[Frontend] 历史知识图谱数据格式无效`);
                return null;
            }
            
            // 创建或获取图表实例
            let chart = WendaApp.charts[containerId];
            if (!chart) {
                chart = echarts.init(container);
                WendaApp.charts[containerId] = chart;
            } else if (chart.isDisposed()) {
                chart = echarts.init(container);
                WendaApp.charts[containerId] = chart;
            } else {
                chart.clear();
            }
            
            // 配置图表选项
        const option = {
            tooltip: {
                    trigger: 'item',
                    confine: true,
                    enterable: false,
                    appendToBody: false,
                    hideDelay: 100,
                formatter: function(params) {
                        // 简化的tooltip格式，不使用复杂HTML
                    if (params.dataType === 'node') {
                            return params.data.name + (params.data.category ? ` (${params.data.category})` : '');
                        } else if (params.dataType === 'edge') {
                            return params.data.value || '关联';
                    }
                    }
                },
                animationDurationUpdate: 1500,
                animationEasingUpdate: 'quinticInOut',
                series: [
                    {
                type: 'graph',
                layout: 'force',
                        data: kgData.nodes,
                        links: kgData.links,
                        categories: [
                            {name: '实体'},
                            {name: '概念'},
                            {name: '属性'}
                        ],
                roam: true,
                label: {
                    show: true,
                            position: 'right',  // 恢复为默认的右侧显示
                            formatter: '{b}'    // 保持简单的名称显示
                },
                force: {
                    repulsion: 100,
                            edgeLength: [50, 100]
                },
                        itemStyle: {
                            borderWidth: 2,
                            borderColor: '#fff'
                },
                lineStyle: {
                    color: 'source',
                            curveness: 0.2
                        },
                        emphasis: {
                            focus: 'adjacency',
                            lineStyle: {
                                width: 4
                            }
                        }
                    }
                ]
            };
            
            // 设置图表选项
            chart.setOption(option);
            
            // 应用新的事件处理
            WendaApp.utils.setupChartEventHandlers(chart);
            
            // 启用鼠标事件处理
            state.preventMouseEvents = false;
            
            return chart;
        } catch (err) {
            console.error(`[Frontend] 初始化历史知识图谱失败:`, err);
            return null;
        }
    }
    
    // ---------- 3. UI交互模块 ----------
    
    // 初始化API选择按钮
    function setupApiButtons() {
        console.log('[Frontend] 设置API按钮');
        const apiButtons = document.querySelectorAll('.api-btn');
        
        apiButtons.forEach(button => {
            button.addEventListener('click', function() {
                const provider = this.getAttribute('data-provider');
                if (provider) {
                    // 移除所有按钮的活动状态
                    document.querySelectorAll('.api-btn').forEach(btn => {
                        btn.classList.remove('btn-primary');
                        btn.classList.add('btn-outline-primary');
                    });
                    
                    // 设置当前按钮的活动状态
                    this.classList.remove('btn-outline-primary');
                    this.classList.add('btn-primary');
                    
                    // 保存API选择
                    localStorage.setItem('current_provider', provider);
                    
                    // 刷新页面以应用新的API选择
                    if (window.location.search.includes('key=')) {
                        window.location.reload();
                    }
                }
            });
        });
    }
    
    // 处理表单提交
    function setupFormSubmission() {
        console.log('[Frontend] 设置表单提交');
        const form = document.getElementById('qa-form');
        if (form) {
            form.addEventListener('submit', function(event) {
                const input = document.getElementById('questionInput');
                if (input && input.value.trim() === '') {
                    event.preventDefault();
                    alert('请输入您的问题');
                    return false;
                }
                
                // 显示加载指示器
                document.body.classList.add('loading');
                
                // 预估处理时间
                const estimatedTime = estimateProcessingTime(input.value);
                console.log(`[Frontend] 预估处理时间: ${estimatedTime/1000}秒`);
            });
        }
    }
    
    // 导出历史记录
    function exportHistory() {
        try {
            const historyData = localStorage.getItem('chat_history');
            if (!historyData) {
                alert('没有可导出的历史记录');
                return;
            }
            
            const blob = new Blob([historyData], {type: 'application/json'});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `medical_qa_history_${new Date().toISOString().slice(0, 10)}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        } catch (err) {
            console.error('[Frontend] 导出历史记录失败:', err);
            alert('导出历史记录失败');
        }
    }
    
    // 清空历史记录
function clearHistory() {
        if (confirm('确定要清空所有历史记录吗？此操作不可恢复。')) {
            localStorage.removeItem('chat_history');
            window.location.reload();
        }
    }
    
    // ---------- 4. 工具函数模块 ----------
    
    // 预估处理时间
    function estimateProcessingTime(question) {
        // 基础时间：10秒
        let baseTime = 10000;
        
        // 根据问题长度调整时间
        const length = question.length;
        if (length > 100) {
            baseTime += 5000;
        }
        if (length > 200) {
            baseTime += 10000;
        }
        
        // 根据问题复杂度调整时间（简单启发式）
        const complexityIndicators = [
            "为什么", "如何", "分析", "比较", "评估", "解释",
            "什么是", "怎样", "原因", "影响", "关系", "区别"
        ];
        
        let complexityScore = 0;
        complexityIndicators.forEach(indicator => {
            if (question.includes(indicator)) {
                complexityScore++;
            }
        });
        
        baseTime += complexityScore * 3000;
        
        return baseTime;
    }
    
    // ---------- 5. 初始化和公共API ----------
    
    // 初始化应用
    window.addEventListener('DOMContentLoaded', function() {
        console.log('[Frontend] DOM内容加载完成，初始化WendaApp');
        
        // 首先修补ECharts事件系统
        patchEChartsEvents();
        
        // 初始化全局API
        WendaApp.utils = {
            setupChartEventHandlers: setupChartEventHandlers,
            enableGlobalEventCapture: enableGlobalEventCapture,
            setupAllChartContainers: setupAllChartContainers,
            startScrollPositionGuard: startScrollPositionGuard,
            patchEChartsEvents: patchEChartsEvents,
            preventNodeNavigation: preventNodeNavigation
        };
        
        // 初始化图表容器
        setTimeout(function() {
        setupAllChartContainers();
            console.log('[Frontend] 图表容器初始化完成');
            
            // 确保允许鼠标事件处理
            state.preventMouseEvents = false;
            console.log('[Frontend] 已完全启用所有鼠标事件处理');
            
            // 设置已初始化标志
            WendaApp.initialized = true;
            
            // 自动初始化已加载的图表
            if (document.getElementById('knowledgeGraphPreview')) {
                console.log('[Frontend] 自动初始化知识图谱');
                WendaApp.initKnowledgeGraph();
            }
            
            if (document.getElementById('processFlowchart')) {
                console.log('[Frontend] 自动初始化流程图');
                WendaApp.initProcessFlowchart();
            }
        }, 1000);
        
        // 设置API按钮
        WendaApp.setupApiButtons();
        
        // 设置表单提交处理
        WendaApp.setupFormSubmission();
    });

    // 添加工具函数到全局命名空间
    WendaApp.exportHistory = exportHistory;
    WendaApp.clearHistory = clearHistory;
    WendaApp.initKnowledgeGraph = initKnowledgeGraph;
    WendaApp.initProcessFlowchart = initProcessFlowchart;
    WendaApp.initHistoryKg = initHistoryKg;
    WendaApp.initFlowchart = initProcessFlowchart; // 允许initFlowchart作为initProcessFlowchart的别名

    // 公开全局对象
    window.WendaApp = WendaApp;
})();